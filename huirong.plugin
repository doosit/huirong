#!name= 汇融签到抽奖
#!desc= 自动持久化 sid 用户会话，动态兑换权鉴并执行签到与抽奖
#!author= doosit
#!homepage= https://github.com/doosit/huirong
#!loon_version= 3.2.1(372)

[MITM]
hostname = bop.mobcb.com

[Script]
http-request ^https:\/\/bop\.mobcb\.com\/api\/v3\/miniapp\/material\/info\/user(?:\?|$) script-path=https://raw.githubusercontent.com/doosit/huirong/refs/heads/main/huirong_loon_sign.js?v=20260805-4,tag=汇融账号会话抓取,timeout=30,argument=capture=auth
http-request ^https:\/\/bop\.mobcb\.com\/api\/v3\/prizesactivity\/member\/remain\/count(?:\?|$) script-path=https://raw.githubusercontent.com/doosit/huirong/refs/heads/main/huirong_loon_sign.js?v=20260805-4,tag=汇融抽奖配置抓取,timeout=30,argument=capture=lottery
cron "0 8 * * *" script-path=https://raw.githubusercontent.com/doosit/huirong/refs/heads/main/huirong_loon_sign.js?v=20260805-4,tag=汇融每日任务,timeout=120,argument=action=all
